# Copy to .env on the Pelasyn server. Never commit the real file.
POSTGRES_DB=fjellfisk
POSTGRES_USER=fjellfisk_backend
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://fjellfisk_backend:replace-with-a-long-random-password@postgres:5432/fjellfisk

# Generate with: openssl rand -base64 48
# This value is server-only and must never be sent to a Collector or Flutter.
COLLECTOR_PAIRING_PEPPER=replace-with-a-256-bit-or-longer-random-secret

# Backend listens only on the Docker network. docker-compose binds it to
# 127.0.0.1 by default, so no internet-facing port is opened.
PORT=8080
LOG_LEVEL=info

# Firebase Auth remains the user login provider. The backend verifies ID tokens
# with Firebase's public signing keys and does not need a service account.
FIREBASE_PROJECT_ID=trolltungaarctictrout

# Set temporarily only while running the one-time authority bootstrap command,
# then remove it. It must be at least 32 characters and is never sent to a
# Collector, Flutter or log.
# COLLECTOR_BOOTSTRAP_SECRET=replace-with-a-one-time-random-secret

# Comma-separated exact browser origins for the self-hosted admin API. Empty
# disables browser cross-origin access rather than falling back to a wildcard.
# Add a fixed local development port only for an explicit private test.
ADMIN_CORS_ORIGINS=https://trolltungaarctictrout.web.app,http://localhost:51099
