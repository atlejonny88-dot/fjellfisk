rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().get('disabled', false) != true;
    }

    function role() {
      return activeUser() ? userData().get('role', 'leser') : 'leser';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isEmployee() {
      return role() == 'ansatt';
    }

    function canWriteProduction() {
      return isAdmin() || isEmployee();
    }

    function authEmail() {
      return request.auth.token.email == null
        ? ''
        : request.auth.token.email;
    }

    function validRole(value) {
      return value in ['admin', 'ansatt', 'leser'];
    }

    function validPreferredLanguage(value) {
      return value in ['nb', 'en', 'pl'];
    }

    function canUpdateOwnPreferredLanguage(userId) {
      return activeUser()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['preferredLanguage'])
        && validPreferredLanguage(request.resource.data.preferredLanguage);
    }

    function validInviteCreate(inviteId, data) {
      return data.keys().hasAll([
          'email', 'emailLower', 'displayName', 'role', 'status',
          'createdAt', 'createdByUid', 'createdByEmail', 'updatedAt',
          'acceptedAt', 'acceptedByUid', 'disabled', 'inviteToken',
          'expiresAt'
        ])
        && data.keys().hasOnly([
          'email', 'emailLower', 'displayName', 'role', 'status',
          'createdAt', 'createdByUid', 'createdByEmail', 'updatedAt',
          'acceptedAt', 'acceptedByUid', 'disabled', 'inviteToken',
          'expiresAt'
        ])
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.emailLower == data.email
        && data.displayName is string
        && data.displayName.size() <= 160
        && validRole(data.role)
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.createdByUid == request.auth.uid
        && data.createdByEmail == authEmail()
        && data.updatedAt == request.time
        && data.acceptedAt == null
        && data.acceptedByUid == null
        && data.disabled == false
        && data.inviteToken == inviteId
        && data.expiresAt is timestamp
        && data.expiresAt > request.time;
    }

    function validInvitedProfile(userId, data) {
      let invite = get(
        /databases/$(database)/documents/userInvites/$(data.inviteId)
      ).data;
      return signedIn()
        && request.auth.uid == userId
        && data.keys().hasAll([
          'email', 'emailLower', 'name', 'role', 'disabled', 'createdAt',
          'updatedAt', 'inviteId'
        ])
        && data.keys().hasOnly([
          'email', 'emailLower', 'name', 'role', 'disabled', 'createdAt',
          'updatedAt', 'inviteId'
        ])
        && data.email == authEmail().lower()
        && data.emailLower == authEmail().lower()
        && data.name is string
        && data.name.size() <= 160
        && data.role == invite.role
        && validRole(data.role)
        && data.disabled == false
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && invite.emailLower == authEmail().lower()
        && invite.status == 'pending'
        && invite.disabled == false
        && invite.inviteToken == data.inviteId
        && invite.expiresAt > request.time;
    }

    function validDiaryEntry(data) {
      return data.keys().hasAll([
          'title', 'body', 'category', 'createdAt', 'createdByUid',
          'createdByEmail', 'createdByName', 'updatedAt', 'updatedByUid',
          'updatedByEmail', 'entryDate', 'status'
        ])
        && data.keys().hasOnly([
          'title', 'body', 'category', 'createdAt', 'createdByUid',
          'createdByEmail', 'createdByName', 'updatedAt', 'updatedByUid',
          'updatedByEmail', 'entryDate', 'status'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 10000
        && data.category in [
          'Hendelse', 'Vedlikehold', 'Observasjon',
          'Fôring', 'Service', 'Annet'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.entryDate is timestamp
        && data.createdByUid is string
        && data.createdByEmail is string
        && data.createdByName is string
        && data.updatedByUid is string
        && data.updatedByEmail is string
        && data.status in ['active', 'archived'];
    }

    function validNotificationCreate(data, userId) {
      return data.keys().hasAll([
          'userId', 'eventKey', 'type', 'title', 'body', 'facilityId',
          'sectionId', 'sectionName', 'tankId', 'tankName', 'relatedId',
          'targetFishCount', 'primaryValue', 'secondaryValue', 'occurredAt',
          'createdAt', 'updatedAt',
          'isRead', 'readAt'
        ])
        && data.keys().hasOnly([
          'userId', 'eventKey', 'type', 'title', 'body', 'facilityId',
          'sectionId', 'sectionName', 'tankId', 'tankName', 'relatedId',
          'targetFishCount', 'primaryValue', 'secondaryValue', 'occurredAt',
          'createdAt', 'updatedAt',
          'isRead', 'readAt'
        ])
        && data.userId == userId
        && data.eventKey is string
        && data.eventKey.size() > 0
        && data.eventKey.size() <= 320
        && data.type in [
          'highMortality', 'lowFeedStock', 'tankNote', 'diaryEntry',
          'appUpdate'
        ]
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.body is string
        && data.body.size() <= 400
        && data.facilityId is string
        && data.sectionId is string
        && data.sectionName is string
        && data.tankId is string
        && data.tankName is string
        && data.relatedId is string
        && data.targetFishCount is int
        && data.targetFishCount >= 0
        && data.primaryValue is number
        && data.primaryValue >= 0
        && data.secondaryValue is number
        && data.secondaryValue >= 0
        && data.occurredAt is timestamp
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.isRead == false
        && data.readAt == null;
    }

    function validNotificationReadUpdate(data) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'readAt', 'updatedAt'
        ])
        && resource.data.isRead == false
        && data.isRead == true
        && data.readAt == request.time
        && data.updatedAt == request.time;
    }

    function validNotificationState(data) {
      return data.keys().hasAll(['key', 'active', 'cycle', 'updatedAt'])
        && data.keys().hasOnly(['key', 'active', 'cycle', 'updatedAt'])
        && data.key is string
        && data.key.size() > 0
        && data.key.size() <= 320
        && data.active is bool
        && data.cycle is int
        && data.cycle >= 0
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow create: if validInvitedProfile(userId, request.resource.data);

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if (isAdmin()
          && validRole(request.resource.data.role)
          && request.resource.data.disabled is bool)
        || canUpdateOwnPreferredLanguage(userId);
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if activeUser() && request.auth.uid == userId;
        allow create: if activeUser()
          && request.auth.uid == userId
          && validNotificationCreate(request.resource.data, userId);
        allow update: if activeUser()
          && request.auth.uid == userId
          && validNotificationReadUpdate(request.resource.data);
        allow delete: if false;
      }

      match /notificationStates/{stateId} {
        allow read: if activeUser() && request.auth.uid == userId;
        allow create, update: if activeUser()
          && request.auth.uid == userId
          && validNotificationState(request.resource.data);
        allow delete: if false;
      }
    }

    match /userInvites/{inviteId} {
      allow get: if isAdmin()
        || (
          inviteId == resource.data.inviteToken
          && resource.data.status == 'pending'
          && resource.data.disabled == false
          && resource.data.expiresAt > request.time
        );
      allow list: if isAdmin();

      allow create: if isAdmin()
        && validInviteCreate(inviteId, request.resource.data);

      allow update: if (
          isAdmin()
          && request.resource.data.email == resource.data.email
          && request.resource.data.emailLower == resource.data.emailLower
          && request.resource.data.role == resource.data.role
          && request.resource.data.inviteToken == resource.data.inviteToken
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdByUid == resource.data.createdByUid
        )
        || (
          signedIn()
          && resource.data.emailLower == authEmail().lower()
          && resource.data.status == 'pending'
          && resource.data.disabled == false
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedAt', 'acceptedByUid', 'updatedAt'
          ])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.acceptedByUid == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.inviteId == inviteId
          && getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }

    match /feed_inventory/{feedId} {
      allow read: if activeUser();
      allow create, update: if canWriteProduction();
      allow delete: if isAdmin();
    }

    match /feed_inventory_history/{historyId} {
      allow read: if activeUser();
      allow create: if canWriteProduction();
      allow update, delete: if isAdmin();
    }

    function validVaconPump(data) {
      return data.keys().hasAll([
          'name', 'ip', 'port', 'model', 'minHz', 'maxHz',
          'commissioned', 'remoteControlEnabled', 'createdAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ip is string && data.ip.size() > 6 && data.ip.size() <= 45
        && data.port is int && data.port > 0 && data.port <= 65535
        && data.model is string && data.model.size() <= 100
        && data.minHz is number && data.maxHz is number
        && data.minHz >= 0 && data.maxHz > data.minHz && data.maxHz <= 200
        && data.commissioned is bool
        && data.remoteControlEnabled is bool;
    }

    function validVaconCommand(data, facilityId) {
      let pumpPath = /databases/$(database)/documents/facilities/$(facilityId)/vaconPumps/$(data.pumpId);
      let pump = get(pumpPath).data;
      return isAdmin()
        && data.keys().hasAll([
          'pumpId', 'type', 'value', 'status', 'requestedByUid',
          'requestedAt', 'expiresAt'
        ])
        && data.keys().hasOnly([
          'pumpId', 'type', 'value', 'status', 'requestedByUid',
          'requestedAt', 'expiresAt'
        ])
        && data.pumpId is string && data.pumpId.size() > 0
        && exists(pumpPath)
        && data.type in ['start', 'stop', 'setFrequency', 'faultReset']
        && data.status == 'queued'
        && data.requestedByUid == request.auth.uid
        && data.requestedAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(30, 's')
        && pump.commissioned == true
        && pump.remoteControlEnabled == true
        && pump.connection == 'online'
        && pump.measuredAt is timestamp
        && pump.measuredAt >= request.time - duration.value(20, 's')
        && pump.measuredAt <= request.time
        && (
          (data.type == 'setFrequency' && data.value is number
            && data.value >= pump.minHz && data.value <= pump.maxHz)
          || (data.type != 'setFrequency' && data.value == null)
        );
    }

    match /facilities/{facilityId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();

      // Client can register an INACTIVE device. Only a trusted gateway with
      // Admin SDK credentials may commission a pump or publish telemetry.
      match /vaconPumps/{pumpId} {
        allow read: if activeUser();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'name', 'ip', 'port', 'model', 'minHz', 'maxHz',
            'commissioned', 'remoteControlEnabled', 'createdAt'
          ])
          && validVaconPump(request.resource.data)
          && request.resource.data.commissioned == false
          && request.resource.data.remoteControlEnabled == false
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin() && resource.data.commissioned == false
          && validVaconPump(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'ip', 'port', 'model', 'minHz', 'maxHz'
          ]);
        allow delete: if false;
      }

      // Immutable requests; no client may declare commands executed.
      // Trusted gateway must re-check live interlocks, age, role, TTL and
      // measured readback before any Modbus write and acknowledgement.
      match /vaconPumpCommands/{commandId} {
        allow read: if activeUser();
        allow create: if validVaconCommand(request.resource.data, facilityId);
        allow update, delete: if false;
      }

      match /vaconPumpAudit/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /diaryEntries/{entryId} {
        allow read: if activeUser();

        allow create: if canWriteProduction()
          && validDiaryEntry(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByEmail == authEmail()
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.updatedByEmail == authEmail()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status == 'active';

        allow update: if activeUser()
          && validDiaryEntry(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.entryDate == resource.data.entryDate
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.updatedByEmail == authEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'body', 'category', 'status', 'updatedAt',
            'updatedByUid', 'updatedByEmail'
          ])
          && (
            isAdmin()
            || (
              isEmployee()
              && resource.data.createdByUid == request.auth.uid
              && resource.data.status == 'active'
              && request.resource.data.status == 'active'
            )
          );

        allow delete: if false;
      }

      match /sections/{sectionId} {
        allow read: if activeUser();
        allow create, update, delete: if isAdmin();

        match /tanks/{tankId} {
          allow read: if activeUser();
          allow create, delete: if isAdmin();
          allow update: if isAdmin()
            || (isEmployee()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fishCount']));

          match /logs/{logId} {
            allow read: if activeUser();
            allow create: if canWriteProduction();
            allow update, delete: if isAdmin();
          }

          match /tankNotes/{noteId} {
            allow read: if activeUser();
            allow create, update: if canWriteProduction();
            allow delete: if isAdmin();
          }

          match /weightSamples/{sampleId} {
            allow read: if activeUser();
            allow create: if canWriteProduction();
            allow update, delete: if isAdmin();
          }
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
