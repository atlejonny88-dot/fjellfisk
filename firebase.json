    "functions": [
                    {
                      "source": "functions",
                      "codebase": "default",
                      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
                      "ignore": [
                        "node_modules",
                        ".git",
                        "firebase-debug.log",
                        "firebase-debug.*.log",
                        "*.local"
                      ]
                    }
                  ],
    "hosting":  [
                    {
                    "target": "legacy",
                    "predeploy": ["node tool/prepare_web_release.cjs"],
                    "public":  "build/web",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                          "source": "/collector/v1/**",
